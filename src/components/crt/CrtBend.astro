---
// ===== CONFIG =====
const bend = {
    strength: 0.001, // start high so it's obvious, then lower it
};
// ==================
---

<div id="crt-bend-config" data-strength={bend.strength} hidden></div>

<script>
    const k = Number(
        document.getElementById("crt-bend-config")?.dataset.strength ?? 0.1,
    );
    const root = document.getElementById("crt-root");
    const NS = "http://www.w3.org/2000/svg";

    function apply() {
        if (!root) {
            console.warn("[crt-bend] #crt-root not found");
            return;
        }
        const w = window.innerWidth;
        const h = window.innerHeight;
        const N = 256;
        const scale = 2 * k * Math.max(w, h);

        const canvas = document.createElement("canvas");
        canvas.width = N;
        canvas.height = N;
        const ctx = canvas.getContext("2d")!;
        const img = ctx.createImageData(N, N);

        for (let y = 0; y < N; y++) {
            for (let x = 0; x < N; x++) {
                const nx = (x / (N - 1)) * 2 - 1;
                const ny = (y / (N - 1)) * 2 - 1;
                const r2 = nx * nx + ny * ny;
                const offX = -k * r2 * nx * (w / 2);
                const offY = -k * r2 * ny * (h / 2);
                const i = (y * N + x) * 4;
                img.data[i] = Math.max(
                    0,
                    Math.min(255, 127.5 + (offX / scale) * 255),
                );
                img.data[i + 1] = Math.max(
                    0,
                    Math.min(255, 127.5 + (offY / scale) * 255),
                );
                img.data[i + 2] = 128;
                img.data[i + 3] = 255;
            }
        }
        ctx.putImageData(img, 0, 0);
        const url = canvas.toDataURL("image/png");

        // Wait for the image to be decodable before attaching the filter
        const probe = new Image();
        probe.onload = () => {
            document.getElementById("crt-bend-svg")?.remove();

            const svg = document.createElementNS(NS, "svg");
            svg.setAttribute("id", "crt-bend-svg");
            svg.setAttribute("width", "0");
            svg.setAttribute("height", "0");
            svg.style.position = "absolute";
            svg.innerHTML = `
        <filter id="crt-bend" filterUnits="userSpaceOnUse" primitiveUnits="userSpaceOnUse"
                x="0" y="0" width="${w}" height="${h}" color-interpolation-filters="sRGB">
          <feImage href="${url}" x="0" y="0" width="${w}" height="${h}"
                   preserveAspectRatio="none" result="map" />
          <feDisplacementMap in="SourceGraphic" in2="map" scale="${scale}"
                             xChannelSelector="R" yChannelSelector="G" />
        </filter>`;
            document.body.appendChild(svg);

            root.style.filter = "none";
            void root.offsetWidth; // force reflow so the filter re-applies
            root.style.filter = "url(#crt-bend)";
            console.log("[crt-bend] applied", { w, h, k, scale });
        };
        probe.src = url;
    }

    apply();
    let t: number;
    window.addEventListener("resize", () => {
        clearTimeout(t);
        t = window.setTimeout(apply, 150);
    });
</script>
